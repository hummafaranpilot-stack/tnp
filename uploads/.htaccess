# Disable PHP execution in uploads folder (critical security)
<FilesMatch "\.(php|php3|php4|php5|php7|phtml|phar)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

php_flag engine off

# Allow only image types to be served
<FilesMatch "\.(jpe?g|png|gif|webp|svg)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# Long-cache product images. Filenames are random hex, so the same name
# never points at a different image — safe to cache for a year. Once a
# browser has the image, it never refetches, so a flaky network on a
# return visit can't blank out the thumbnail.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png  "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/gif  "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(jpe?g|png|gif|webp|svg)$">
        # `immutable` was removed deliberately — we re-compress files in
        # place via Optimize Images, and `immutable` would lock browsers/
        # CDN onto the pre-optimized bytes for a year. We rely instead on
        # bust_image_cache() to append a ?v=<mtime> query string so the
        # URL changes whenever the file does.
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
</IfModule>

Options -Indexes
